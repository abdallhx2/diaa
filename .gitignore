# Push only program/ folder
/*
!program/
!.gitignore

# Inside program - ignore env files and generated stuff
program/backend/venv/
program/backend/.env
program/backend/__pycache__/
program/backend/app/__pycache__/
program/admin/node_modules/
program/admin/.env.local
program/admin/.next/
program/mobile/.dart_tool/
program/mobile/.packages
program/mobile/build/

# Windows reserved name (do not track)
nul

# Secrets — never commit
program/backend/firebase-credentials.json
program/backend/*-credentials.json
program/backend/service-account*.json

# JVM crash dumps
program/hs_err_pid*.log
program/replay_pid*.log

# Local test artifacts (screenshots, UI dumps)
program/test_artifacts/
