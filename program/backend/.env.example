# ============================================================
# Edu Smart Assistant — Backend Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Database / قاعدة البيانات ---
# رابط الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/edu_smart

# --- Firebase / فايربيس ---
# مسار ملف حساب خدمة Firebase (JSON)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
# اسم حاوية التخزين في Firebase (بدون gs://)
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# --- OpenRouter / الذكاء الاصطناعي (مزود واحد لجميع الخدمات) ---
# مفتاح API من https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# نموذج المحادثة الذكية
CHAT_MODEL=openai/gpt-4o-mini
# نموذج الرؤية لاستخراج النص من الصور (OCR)
VISION_MODEL=openai/gpt-4o-mini
# نموذج تحويل النص إلى صوت (TTS) — يستخدم streaming audio
TTS_MODEL=openai/gpt-audio-mini
# صوت TTS (alloy, ash, ballad, coral, echo, fable, onyx, nova, sage, shimmer, verse)
TTS_VOICE=alloy

# --- App Settings ---
# بيئة التشغيل: development | production
APP_ENV=development
# منفذ السيرفر (Railway يضبطه تلقائيا)
PORT=8000
# النطاقات المسموح لها بالوصول (CORS)، مفصولة بفواصل
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# --- Mock Mode / وضع المحاكاة ---
# عند التفعيل (true) يستخدم بيانات وهمية بدلا من الخدمات الخارجية
# مفيد للتطوير المحلي بدون مفاتيح API حقيقية
USE_MOCKS=true
